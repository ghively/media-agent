# Media Agent Configuration
# Copy to settings.yaml and fill in real values (or use env vars)

server:
  host: "0.0.0.0"
  port: 8088
  api_key: "${MEDIA_AGENT_API_KEY}"

llm:
  ollama_url: "http://agent-lab-ollama-1:11435"
  ollama_model: "qwen3.5:9b"
  hosted_url: ""
  hosted_key: ""
  hosted_model: ""
  temperature: 0
  timeout: 15
  # Small-model tuning:
  num_ctx: 8192          # Ollama context window (default 2048 silently truncates tool prompts)
  num_predict: 1024      # cap on output tokens per LLM step
  keep_alive: "10m"      # keep the model loaded between agent steps
  recursion_limit: 12    # max ReAct steps per request (bounds runaway loops)

services:
  sonarr:
    url: "http://192.168.0.133:8989"
    api_key: "${SONARR_API_KEY}"
    quality_profile_id: 1     # used when adding shows
    root_folder: "/tv/"       # used when adding shows
  radarr:
    url: "http://192.168.0.133:8310"
    api_key: "${RADARR_API_KEY}"
    quality_profile_id: 1     # used when adding movies
    root_folder: "/movies/"   # used when adding movies
  emby:
    url: "http://192.168.0.144:8096"
    api_key: "${EMBY_API_KEY}"
  sabnzbd:
    url: "http://192.168.0.133:8080"
    api_key: "${SABNZBD_API_KEY}"
  # Optional — Synology Download Station (torrents)
  download_station:
    url: "http://192.168.0.133:5000"
    username: "${DS_USER}"
    password: "${DS_PASS}"
  # Optional — YouTube downloads/subscriptions (needs yt-dlp installed)
  youtube:
    download_path: "/media/youtube"
    subscriptions_file: "/state/youtube_subs.json"

# Scheduled automation — deterministic pipelines, no LLM involved.
# Available jobs: health_check, missing_search, youtube_sync, audible_sync
# trigger: a template name (see src/scheduler.py) or cron "min hour dom mon dow"
scheduler:
  enabled: false
  jobs:
    - name: health_check          # every 30 min
    - name: missing_search        # every 12 h
    - name: youtube_sync          # every 6 h
    # - name: audible_sync        # daily 4:00
    # - name: youtube_sync
    #   trigger: "0 */4 * * *"    # custom cron override

library:
  media_root: "/media"
  naming_conventions:
    movies: "/movies/{title} ({year})/{title} ({year}).{ext}"
    tv: "/tv/{show}/Season {season:02d}/{show} - s{season:02d}e{episode:02d} - {title}.{ext}"
