# Media Agent Configuration
# Copy to settings.yaml and fill in real values (or use env vars)

server:
  host: "0.0.0.0"
  port: 8088
  api_key: "${MEDIA_AGENT_API_KEY}"

# LLM settings are driven by .env (see .env.example for the two supported
# model profiles) with safe defaults baked in — ${VAR:-default} falls back
# to the default when the env var is unset.
llm:
  ollama_url: "${OLLAMA_URL:-http://agent-lab-ollama-1:11435}"
  # Model profiles (see docs/AGENT.md "Model profiles" and .env.example):
  #   Profile A (default): OLLAMA_MODEL=qwen2.5:7b, OLLAMA_REASONING unset
  #     — non-thinking, solid tool calling (~4.7 GB)
  #   Profile B (thinking): OLLAMA_MODEL=qwen3.5:9b, OLLAMA_REASONING=false
  #     — stronger tool calling per size (~6.6 GB); qwen3.5:4b is the
  #       smallest reliable option (~3.4 GB)
  # Models below ~4B (qwen3.5:2b, llama3.2:3b) drop or malform tool calls
  # too often with a tool list this large — not recommended.
  ollama_model: "${OLLAMA_MODEL:-qwen2.5:7b}"
  # IMPORTANT: Ollama's default context (2048-4096) is too small for this
  # agent's system prompt + tool schemas. When the context overflows, Ollama
  # silently truncates the prompt and the model starts printing tool-call
  # JSON into chat. 16384 is a safe floor; lower to 8192 if RAM is tight.
  num_ctx: "${OLLAMA_NUM_CTX:-16384}"
  # Keep the model loaded between requests (avoids reload latency)
  keep_alive: "10m"
  # ONLY for thinking models (qwen3/qwen3.5, deepseek-r1): set to false to
  # ask Ollama to disable the reasoning trace. MUST stay unset/empty for
  # non-thinking models (qwen2.5, llama3.x) — Ollama rejects the think flag
  # for models that don't support it. Leaked <think> blocks are stripped
  # from responses in-app either way.
  reasoning: "${OLLAMA_REASONING:-}"
  # Optional hosted fallback, used automatically when Ollama is unreachable
  hosted_url: "${HOSTED_LLM_URL:-}"
  hosted_key: "${HOSTED_LLM_KEY:-}"
  hosted_model: "${HOSTED_LLM_MODEL:-}"
  temperature: 0

services:
  sonarr:
    url: "${SONARR_URL:-http://192.168.0.133:8989}"
    api_key: "${SONARR_API_KEY}"
  radarr:
    url: "${RADARR_URL:-http://192.168.0.133:8310}"
    api_key: "${RADARR_API_KEY}"
  emby:
    url: "${EMBY_URL:-http://192.168.0.144:8096}"
    api_key: "${EMBY_API_KEY}"
  sabnzbd:
    url: "${SABNZBD_URL:-http://192.168.0.133:8080}"
    api_key: "${SABNZBD_API_KEY}"
  download_station:
    url: "${DOWNLOAD_STATION_URL:-http://192.168.0.133:5000}"
    username: "${DOWNLOAD_STATION_USER:-}"
    password: "${DOWNLOAD_STATION_PASSWORD:-}"
  youtube:
    download_path: "${YOUTUBE_DOWNLOAD_PATH:-/media/youtube}"
    subscriptions_file: "${YOUTUBE_SUBSCRIPTIONS_FILE:-/state/youtube_subscriptions.json}"

# Approval policy per tool: auto | confirm | deny.
# Six high-impact tools default to confirm even if this section is empty:
#   library_sort_dir, rom_download, bandcamp_download_collection,
#   audible_download_new, sabnzbd_add_nzb, download_station_add
# `confirm` is enforced in code: the tool does not run until your actual
# reply contains an explicit yes/approve. Override examples:
approvals: {}
#  rom_download: auto          # trust ROM downloads without asking
#  emby_scan: confirm          # gate additional tools if you like
#  download_station_add: deny  # disable a tool entirely

scheduler:
  enabled: false
  jobs: []

library:
  media_root: "/media"
  naming_conventions:
    movies: "/movies/{title} ({year})/{title} ({year}).{ext}"
    tv: "/tv/{show}/Season {season:02d}/{show} - s{season:02d}e{episode:02d} - {title}.{ext}"
