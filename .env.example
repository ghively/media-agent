# Media Agent Environment Variables
# Copy to .env and fill in real values from 1Password vault 

# API Keys (from 1Password)
SONARR_API_KEY=
RADARR_API_KEY=
EMBY_API_KEY=
SABNZBD_API_KEY=

# Service URLs
SONARR_URL=http://<YOUR_NAS_IP>:8989
RADARR_URL=http://<YOUR_NAS_IP>:8310
EMBY_URL=http://<YOUR_MEDIA_IP>:8096
SABNZBD_URL=http://<YOUR_NAS_IP>:8080

# LLM Configuration
OLLAMA_URL=http://agent-lab-ollama-1:11435
OLLAMA_MODEL=qwen3.5:9b

# Hosted LLM Fallback (optional)
HOSTED_LLM_URL=
HOSTED_LLM_KEY=
HOSTED_LLM_MODEL=

# API Authentication
MEDIA_AGENT_API_KEY=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8088
