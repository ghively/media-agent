# Media Agent Environment Variables
# Copy to .env and fill in real values from password manager.
#
# Only variables referenced as ${VAR} in config/settings.yaml (or by
# docker-compose.yml) belong here — anything else is silently ignored.
# Service URLs live directly in config/settings.yaml; to move one into the
# environment, change its yaml value to "${SOME_VAR}" and add SOME_VAR here.

# API Keys (from password manager)
SONARR_API_KEY=
RADARR_API_KEY=
EMBY_API_KEY=
SABNZBD_API_KEY=

# Synology Download Station credentials
DS_USERNAME=
DS_PASSWORD=

# Optional service integrations (leave empty until deployed)
LIDARR_API_KEY=
PROWLARR_API_KEY=
KOMGA_API_KEY=
CALIBRE_PASSWORD=
QBIT_USERNAME=
QBIT_PASSWORD=

# Telegram interface (get a token from @BotFather; optional)
TELEGRAM_BOT_TOKEN=

# Hosted LLM fallback (optional — leave empty for local-only operation)
HOSTED_LLM_URL=
HOSTED_LLM_KEY=
HOSTED_LLM_MODEL=

# API Authentication (recommended: openssl rand -hex 16).
# The dashboard prompts for this key on first load when set.
MEDIA_AGENT_API_KEY=

# Host path mounted at /media in the container (docker-compose.yml).
# Point at the real media library (e.g. an NFS mount of the NAS).
MEDIA_ROOT=./media
