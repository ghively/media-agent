# Media Agent Environment Variables
# Copy to .env and fill in real values from 1Password vault "Gregory"

# API Keys (from 1Password)
SONARR_API_KEY=
RADARR_API_KEY=
EMBY_API_KEY=
SABNZBD_API_KEY=

# Service URLs
SONARR_URL=http://192.168.0.133:8989
RADARR_URL=http://192.168.0.133:8310
EMBY_URL=http://192.168.0.144:8096
SABNZBD_URL=http://192.168.0.133:8080

# Optional services — tools appear only when configured
LIDARR_URL=
LIDARR_API_KEY=
BAZARR_URL=
BAZARR_API_KEY=

# Synology Download Station (optional — leave user empty to disable)
DOWNLOAD_STATION_URL=http://192.168.0.133:5000
DOWNLOAD_STATION_USER=
DOWNLOAD_STATION_PASSWORD=

# YouTube (yt-dlp)
YOUTUBE_DOWNLOAD_PATH=/media/youtube
YOUTUBE_SUBSCRIPTIONS_FILE=/state/youtube_subscriptions.json

# LLM Configuration — pick ONE model profile (both fully supported;
# switch by editing these two lines and restarting the container:
#   docker compose up -d --force-recreate media-agent
# Make sure the model is pulled first: ollama pull <model>).
#
# Profile A — non-thinking (default): fastest responses, no reasoning trace.
#   OLLAMA_MODEL=qwen2.5:7b
#   OLLAMA_REASONING=
#
# Profile B — thinking: stronger tool calling per size, slower first token.
#   OLLAMA_MODEL=qwen3.5:9b     (or qwen3.5:4b on small hardware)
#   OLLAMA_REASONING=false      (disables the trace; leaks are stripped in-app)
#
# NOTE: OLLAMA_REASONING must stay EMPTY for non-thinking models — Ollama
# rejects the think flag for models without thinking support.
OLLAMA_URL=http://agent-lab-ollama-1:11435
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_REASONING=
# Context window — do not go below 8192 or tool schemas get truncated
OLLAMA_NUM_CTX=16384

# Hosted LLM Fallback (optional)
HOSTED_LLM_URL=
HOSTED_LLM_KEY=
HOSTED_LLM_MODEL=

# Telegram notifications (optional — health alerts + weekly digest)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Persistent state directory (conversation memory, approvals, audit log)
STATE_DIR=/state

# API Authentication
MEDIA_AGENT_API_KEY=

# Server
SERVER_HOST=0.0.0.0
SERVER_PORT=8088
