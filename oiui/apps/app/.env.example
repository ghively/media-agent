# Media Agent PoC — UI settings. Copy to apps/app/.env.local.
# Model keys stay on the agent server; the browser never asks for them.
NEXT_PUBLIC_SERVER_KEYS=true
LANGGRAPH_DEPLOYMENT_URL=http://localhost:8123

# Turn off CopilotKit's anonymous install counter (see docs/telemetry.md).
DO_NOT_TRACK=1
NEXT_TELEMETRY_DISABLED=1
