# Media Agent PoC — agent settings. Copy to apps/agent/.env and fill in.
# Never commit the real .env. Model keys only; media service keys stay in
# media-agent's own ../../../.env and config/settings.yaml.

# Cloud model. claude-* uses Anthropic, gpt-* or chat-latest uses OpenAI.
LLM_MODEL=claude-sonnet-5-5
ANTHROPIC_API_KEY=
# OpenAI instead: set LLM_MODEL=chat-latest and fill this in.
OPENAI_API_KEY=

# Optional: Jev visualization routing (TypeSafe). Leave blank to keep it off;
# when set, the last few chat messages are sent to TypeSafe on each turn.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
# JEV_ROUTING=off   # force it off even with a key

# Where media-agent's config lives (defaults to <repo>/config/settings.yaml).
# MEDIA_AGENT_CONFIG=/absolute/path/to/settings.yaml
